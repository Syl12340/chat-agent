{
  "enabled": {
    "description": "启用 chat-agent 网关",
    "type": "bool",
    "default": false
  },
  "base_url": {
    "description": "chat-agent 地址",
    "type": "string",
    "default": "http://127.0.0.1:9991",
    "hint": "推荐与 AstrBot 同机并只走回环；远程地址必须自行使用私有 TLS 隧道。"
  },
  "secret": {
    "description": "共享网关密钥",
    "type": "string",
    "default": "",
    "secret": true
  },
  "allowed_platforms": {
    "description": "允许转交的平台 ID",
    "type": "list",
    "default": ["aiocqhttp"],
    "hint": "默认只接 AstrBot 的 OneBot/QQ 适配器；逐个平台验收后再增加。"
  },
  "allow_groups": {
    "description": "允许群聊",
    "type": "bool",
    "default": false
  },
  "poll_interval_ms": {
    "description": "回复拉取间隔（毫秒）",
    "type": "int",
    "default": 800,
    "slider": {"min": 250, "max": 5000, "step": 50}
  }
}
