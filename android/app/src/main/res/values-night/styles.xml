<resources>
    <!-- Night theme: a dark parent flips both the native shell and the WebView's
         prefers-color-scheme, which is what switches the embedded page to AMOLED black. -->
    <style name="Theme.ChatAgent" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">@color/chat_primary</item>
        <item name="android:colorControlActivated">@color/chat_primary</item>
        <item name="android:textColorPrimary">@color/chat_on_surface</item>
        <item name="android:alertDialogTheme">@style/Theme.ChatAgent.Dialog</item>
        <item name="android:windowBackground">@color/chat_paper</item>
        <item name="android:statusBarColor">@color/chat_paper</item>
        <item name="android:navigationBarColor">@color/chat_paper</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
    <style name="Theme.ChatAgent.Dialog" parent="android:style/Theme.Material.Dialog.Alert">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">@color/chat_primary</item>
        <item name="android:colorControlActivated">@color/chat_primary</item>
        <item name="android:textColorPrimary">@color/chat_on_surface</item>
        <item name="android:windowBackground">@color/chat_surface_container</item>
        <item name="android:windowMinWidthMajor">90%</item>
        <item name="android:windowMinWidthMinor">90%</item>
    </style>
</resources>
