# Documentation template only; executables read process environment variables.
# The HTTP server requires a separate random access token (32+ ASCII characters).
# This token is entered in the browser. Never enter the model API key there.
CHAT_ACCESS_TOKEN=replace-with-a-random-token-at-least-32-characters

# Base URL includes /v1 when your service requires it, without /chat/completions.
CHAT_BASE_URL=https://your-api.example/v1
CHAT_API_KEY=replace-on-server
CHAT_MODEL=your-model-id

# ECNU's documented chat endpoint offers ecnu-max / ecnu-plus automatically.
# Other endpoints default to only CHAT_MODEL with text and thinking disabled.
# Optional explicit same-provider chat allowlist (JSON, never API credentials):
# CHAT_CHAT_MODELS=[{"id":"your-model-id","label":"My model","vision":false,"thinking":["off"]}]
# Thinking turns have a separate bounded output budget (128..16384), default 4096.
# Normal chat retains -max-output. Thinking allows at least 120 seconds per turn.
# CHAT_THINKING_MAX_OUTPUT=4096

# Optional encrypted TCP entrance (both required together).
# CHAT_WIRE_LISTEN=0.0.0.0:9992
# CHAT_WIRE_KEY=/etc/chat-agent/transport/signing.key

# Optional authenticated Android update publication (manifest.json + app.apk).
# CHAT_ANDROID_RELEASE_DIR=/opt/chat-agent/android/current

# Public HTML search results, parsed directly. No JSON/RSS wrapper is used
# by the main agent. -enable-web defaults to https://cn.bing.com/search.
# Deployment start.sh uses CHAT_ENABLE_WEB=1 to add -enable-web.
# CHAT_ENABLE_WEB=1
# CHAT_SEARCH_URL=https://cn.bing.com/search
# Optional exact fetch host restriction; empty allows checked public HTTPS.
# CHAT_WEB_HOSTS=example.org,docs.example.org

# Optional gateway reranking and separate history-summary model.
# CHAT_RERANK_MODEL=your-rerank-model
# CHAT_UTILITY_MODEL=your-summary-model

# Topic discovery has no auto-enable environment variable. Enable it explicitly
# per role in the UI; only your configured public-interest queries leave server.

# Optional, explicitly clicked speech; uses the server-side model gateway/key.
# Leave unset to disable. Current ECNU model/voice:
# CHAT_TTS_MODEL=ecnu-tts
# CHAT_TTS_VOICE=xiayu
