[Unit]
Description=chat-agent
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
User=chat-agent
Group=chat-agent
WorkingDirectory=/var/lib/chat-agent
EnvironmentFile=/etc/chat-agent/chat-agent.env
Environment=GOMEMLIMIT=160MiB GOMAXPROCS=2
ExecStart=/opt/chat-agent/current/start.sh
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
StateDirectory=chat-agent
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictNamespaces=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
LockPersonality=true
MemoryMax=256M
TasksMax=128
StandardOutput=journal
StandardError=journal
SyslogIdentifier=chat-agent

[Install]
WantedBy=multi-user.target
