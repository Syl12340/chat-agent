# Loaded by systemd, not automatically by the Go executable.
# Keep this file root-owned with mode 0600. Do not commit real credentials.
# The installer appends a cryptographically random CHAT_ACCESS_TOKEN.
CHAT_MODE=demo
CHAT_BASE_URL=
CHAT_API_KEY=
CHAT_MODEL=

# Optional encrypted TCP entrance; configure both together.
# CHAT_WIRE_LISTEN=0.0.0.0:9992
# CHAT_WIRE_KEY=/etc/chat-agent/transport/signing.key

# Optional authenticated Android update publication.
# CHAT_ANDROID_RELEASE_DIR=/opt/chat-agent/android/current

# Local search is opt-in; the installer writes matching independent credentials.
# CHAT_ENABLE_WEB=1
# CHAT_LOCAL_SEARCH_URL=http://127.0.0.1:9993/search
# CHAT_LOCAL_SEARCH_KEY=separate-random-token-shared-with-local-search-only

# Optional, explicitly clicked speech; uses the server-side model gateway/key.
# Leave unset to disable. Current ECNU model/voice:
# CHAT_TTS_MODEL=ecnu-tts
# CHAT_TTS_VOICE=xiayu

# Installed plugins are compiled into the binary; whether they load, and which
# declared permissions they actually receive, stay a host decision here.
# Disabling a plugin removes its tools and stops advertising its services.
# Grants are "plugin-id:permission" and never implied by a manifest.
# CHAT_PLUGINS_DISABLED=builtin.search
# CHAT_PLUGIN_GRANTS=builtin.search:network:public-https

# Host tools are opt-in for exact CA session IDs and named grants.
# CHAT_HOST_TOOL_SESSIONS=
# CHAT_WORKSPACE_ROOT=/srv/chat-agent-workspace
# CHAT_WORKSPACE_ACTIONS='{"list": ["/usr/bin/ls", "-la"]}'
# CHAT_PLUGIN_GRANTS=builtin.workspace:filesystem:workspace://server,builtin.server:filesystem:diagnostics://host

# Optional OneBot v11 owner-private channel. Keep disabled until SnowLuma or
# another compatible implementation is connected through loopback/SSH.
ONEBOT_ENABLED=false# ONEBOT_ACCOUNT_ID=
# ONEBOT_OWNER_QQ_ID=
# ONEBOT_INGRESS_SECRET=
# ONEBOT_ACTION_BASE_URL=http://127.0.0.1:13000/
# ONEBOT_ACTION_TOKEN=
# ONEBOT_ROLE_ID=companion
# ONEBOT_TIMEOUT=5s
# ONEBOT_MAX_BODY_BYTES=262144
