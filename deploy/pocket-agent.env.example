# Loaded by systemd, not automatically by the Go executable.
# Keep this file root-owned with mode 0600. Do not commit real credentials.
# The installer appends a cryptographically random POCKET_ACCESS_TOKEN.
POCKET_MODE=demo
POCKET_BASE_URL=
POCKET_API_KEY=
POCKET_MODEL=

# Optional encrypted TCP entrance; configure both together.
# POCKET_WIRE_LISTEN=0.0.0.0:9992
# POCKET_WIRE_KEY=/etc/pocket-agent/transport/signing.key

# Optional authenticated Android update publication.
# POCKET_ANDROID_RELEASE_DIR=/opt/pocket-agent/android/current

# Local search is opt-in; the installer writes matching independent credentials.
# POCKET_ENABLE_WEB=1
# POCKET_LOCAL_SEARCH_URL=http://127.0.0.1:9993/search
# POCKET_LOCAL_SEARCH_KEY=separate-random-token-shared-with-local-search-only

# Optional, explicitly clicked speech; uses the server-side model gateway/key.
# Leave unset to disable. Current ECNU model/voice:
# POCKET_TTS_MODEL=ecnu-tts
# POCKET_TTS_VOICE=xiayu
